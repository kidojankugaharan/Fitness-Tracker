VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Server-side only (no VITE_ prefix, never sent to the browser): USDA FoodData Central key for
# barcode lookups (free: https://fdc.nal.usda.gov/api-key-signup). Unset = DEMO_KEY (a few/hour).
# Set it in Vercel → Settings → Environment Variables too.
FDC_API_KEY=
